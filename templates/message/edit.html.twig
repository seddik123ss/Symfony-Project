{% extends 'base.html.twig' %}

{% block title %}Modifier le message{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .edit-wrapper { padding: 2rem 0; }
    .card-edit { border-radius: 12px; box-shadow: 0 8px 30px rgba(0,0,0,0.08); overflow: hidden; }
    .card-header-edit { background: linear-gradient(135deg,#667eea 0%,#764ba2 100%); color:white; padding:1.5rem; }
    .form-body { padding: 1.5rem; }

    /* Validation error styles */
    .form-control.is-invalid {
        border-color: #dc3545;
        box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.15);
    }

    .invalid-feedback {
        display: block;
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .char-counter {
        font-size: 0.8rem;
        color: #6c757d;
        margin-top: 0.25rem;
    }

    .char-counter.warning {
        color: #ffc107;
    }

    .char-counter.danger {
        color: #dc3545;
    }

    .js-error {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: none;
    }
</style>
{% endblock %}

{% block body %}
<div class="container edit-wrapper">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>{{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            <div class="card card-edit">
                <div class="card-header-edit">
                    <h3 class="mb-0"><i class="fas fa-edit me-2"></i>Modifier le message</h3>
                    <p class="mb-0 small">Modifiez le contenu ou le sujet du message.</p>
                </div>
                <div class="form-body">
                    {{ form_start(form) }}

                    <div class="mb-3">
                        {{ form_label(form.subject, 'Sujet (max 20 caractères)') }}
                        {{ form_widget(form.subject, {'attr': {'class': form_errors(form.subject) ? 'form-control is-invalid' : 'form-control', 'maxlength': '20', 'id': 'message_subject'}}) }}
                        <div class="char-counter" id="subject-counter">0/20 caractères</div>
                        <div class="js-error" id="subject-error"></div>
                        {% if form_errors(form.subject) %}
                            <div class="invalid-feedback">
                                {{ form_errors(form.subject) }}
                            </div>
                        {% endif %}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.content, 'Message') }}
                        {{ form_widget(form.content, {'attr': {'class': form_errors(form.content) ? 'form-control is-invalid' : 'form-control','rows':6, 'id': 'message_content'}}) }}
                        <div class="js-error" id="content-error"></div>
                        {% if form_errors(form.content) %}
                            <div class="invalid-feedback">
                                {{ form_errors(form.content) }}
                            </div>
                        {% endif %}
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ path('message_index') }}" class="btn btn-secondary">
                            <i class="fas fa-times me-1"></i>Annuler
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Enregistrer
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const subjectField = document.getElementById('message_subject');
    const contentField = document.getElementById('message_content');
    const subjectCounter = document.getElementById('subject-counter');
    const subjectError = document.getElementById('subject-error');
    const contentError = document.getElementById('content-error');
    const form = document.querySelector('form');

    // Subject validation
    function validateSubject() {
        const value = subjectField.value.trim();
        const length = value.length;
        
        // Update counter
        subjectCounter.textContent = `${length}/20 caractères`;
        
        // Remove existing classes
        subjectCounter.classList.remove('warning', 'danger');
        subjectField.classList.remove('is-invalid');
        subjectError.style.display = 'none';
        
        if (length === 0) {
            subjectField.classList.add('is-invalid');
            subjectError.textContent = 'Le sujet est obligatoire';
            subjectError.style.display = 'block';
            return false;
        } else if (length > 20) {
            subjectField.classList.add('is-invalid');
            subjectCounter.classList.add('danger');
            subjectError.textContent = 'Le sujet ne peut pas dépasser 20 caractères';
            subjectError.style.display = 'block';
            return false;
        } else if (length > 15) {
            subjectCounter.classList.add('warning');
        }
        
        return true;
    }

    // Content validation
    function validateContent() {
        const value = contentField.value.trim();
        
        contentField.classList.remove('is-invalid');
        contentError.style.display = 'none';
        
        if (value.length === 0) {
            contentField.classList.add('is-invalid');
            contentError.textContent = 'Le contenu du message est obligatoire';
            contentError.style.display = 'block';
            return false;
        }
        
        return true;
    }

    // Real-time validation
    subjectField.addEventListener('input', validateSubject);
    subjectField.addEventListener('blur', validateSubject);
    contentField.addEventListener('input', validateContent);
    contentField.addEventListener('blur', validateContent);

    // Form submission validation
    form.addEventListener('submit', function(e) {
        const isSubjectValid = validateSubject();
        const isContentValid = validateContent();
        
        if (!isSubjectValid || !isContentValid) {
            e.preventDefault();
            
            // Scroll to first error
            const firstError = document.querySelector('.is-invalid');
            if (firstError) {
                firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                firstError.focus();
            }
        }
    });

    // Initialize counter
    validateSubject();
});
</script>
{% endblock %}
