###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=your_app_secret_here
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# DATABASE_URL format: "mysql://user:password@host:port/dbname?serverVersion=version&charset=utf8mb4"
DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/db_name"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Example transports
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN="smtp://your_email@gmail.com:your_app_password@smtp.gmail.com:587?encryption=tls&auth_mode=login"
GMAIL_SENDER_EMAIL="your_email@gmail.com"
GMAIL_SENDER_NAME="Message System"
###< symfony/mailer ###

###> google oauth ###
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
###< google oauth ###
